# 复制为 agent/.env 并填入真实值（.env 已被 .gitignore 忽略，不要提交）

# ---- LLM 密钥 ----
API_KEY=sk-xxxxxxxxxxxxxxxx
DS_URL=https://api.deepseek.com

# ---- 对外服务安全（P1，可选） ----
# 配置后 /api/v1 与 /ws/chat 必须携带此 key（HTTP 用 X-API-Key 头，WS 支持头或 ?api_key= 参数）；
# 留空或不配置 = 开发模式（本地放行，不鉴权）
AGENT_API_KEY=
# 每 caller 每分钟允许的请求数（令牌桶容量与补充速率），默认 20
AGENT_RATE_LIMIT_PER_MIN=20
# 意图路由开关：1 启用（任务执行前先做一次意图识别，命中工作流时缩小工具集）；默认关闭
AGENT_INTENT_ROUTING=0
